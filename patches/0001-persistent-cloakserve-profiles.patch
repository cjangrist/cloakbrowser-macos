 # returning 502 forever. See CloakHQ/CloakBrowser#283.
 rm -f /tmp/.X99-lock /tmp/.X11-unix/X99
 
+# Preserve the profile while moving stale Chromium singleton locks out of the
+# active user-data directory after a container restart. A container hostname is
+# part of Chromium's lock target, so a cleanly stopped prior container otherwise
+# leaves a lock that the replacement container cannot claim.
+_profile_root="${CLOAKSERVE_DATA_DIR:-}"
+if [ -n "${_profile_root}" ] && [ -d "${_profile_root}" ]; then
+  _stale_lock_root="${_profile_root}/.stale_profile_locks/$(date -u +%Y%m%dT%H%M%SZ)_$$"
+  for _profile_dir in "${_profile_root}"/*; do
+    [ -d "${_profile_dir}" ] || continue
+    for _lock_name in SingletonLock SingletonCookie SingletonSocket; do
+      _lock_path="${_profile_dir}/${_lock_name}"
+      if [ -e "${_lock_path}" ] || [ -L "${_lock_path}" ]; then
+        mkdir -p "${_stale_lock_root}/$(basename "${_profile_dir}")"
+        mv "${_lock_path}" "${_stale_lock_root}/$(basename "${_profile_dir}")/${_lock_name}"
+      fi
+    done
+  done
+fi
+
 # Start Xvfb for headed mode (Turnstile, CAPTCHAs), then run user command
-Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp &
+_display_width="${CLOAKBROWSER_DISPLAY_WIDTH:-1920}"
+_display_height="${CLOAKBROWSER_DISPLAY_HEIGHT:-1080}"
+case "${_display_width}:${_display_height}" in
+  *[!0-9:]*|:*|*:) echo "[cloakbrowser] Invalid virtual display dimensions" >&2; exit 2 ;;
+esac
+Xvfb :99 -screen 0 "${_display_width}x${_display_height}x24" -nolisten tcp &
 
